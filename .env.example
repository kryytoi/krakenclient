# Neon Postgres — Neon dashboard -> Connection string (используйте pooled/"-pooler" вариант для serverless)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/kraken?sslmode=require

# Любая длинная случайная строка
SECRET_KEY=change-me-to-something-random

# Логины, которые получают доступ к /admin (через запятую)
ADMIN_USERNAMES=admin

# GitHub-репозиторий с релизами (там лежит зашифрованный .enc с последней сборкой)
GITHUB_REPO=your-org/kraken-client-builds
GITHUB_TOKEN=

# AES-256 ключ (base64, 32 байта) — сгенерировать: python tools/encrypt_build.py <in.jar> <out.enc>
KRAKEN_ENC_KEY_B64=
